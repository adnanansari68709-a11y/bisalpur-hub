# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# GOOGLE_WEB_CLIENT_ID: Required for Google Sign-In with Credential Manager.
# Provide the Web Client ID from Google Cloud Console -> APIs & Services -> Credentials.
# Users configure this in the Secrets panel in AI Studio or via .env.
# Example: GOOGLE_WEB_CLIENT_ID=1234567890-abcdefg.apps.googleusercontent.com
GOOGLE_WEB_CLIENT_ID=NOT_CONFIGURED

